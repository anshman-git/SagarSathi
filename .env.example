# SagarMitra Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional LLM API Key (Runs in zero-key DEMO mode if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional Bhashini Regional Language Speech/Translation Pipeline
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# Simulation & Cache
DATA_CACHE_DIR=./backend/app/data/cache
ENABLE_SCENARIO_MODE=false
